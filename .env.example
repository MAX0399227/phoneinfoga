# PhoneInfoga - variables de entorno para los scanners con API
# Copia este archivo a ".env" y rellena tus claves:  cp .env.example .env
#
# Los scanners "local", "googlesearch" y "ovh" NO necesitan clave.
# Solo configura lo de abajo para activar numverify y googlecse.

# --- Numverify (operador/carrier real) ---
# Regístrate gratis en https://numverify.com y copia tu API Access Key
NUMVERIFY_API_KEY=

# --- Google Custom Search (ejecuta los dorks automáticamente) ---
# API key: https://console.cloud.google.com (habilita "Custom Search API")
GOOGLE_API_KEY=
# Search Engine ID (CX): https://programmablesearchengine.google.com
GOOGLECSE_CX=
# Opcional: número máximo de resultados por dork (por defecto 10)
# GOOGLECSE_MAX_RESULTS=10
